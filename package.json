{
  "name": "urbanflow-components",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build -w @urbanflow/icons && node scripts/llms.mjs && next dev",
    "build": "npm run build -w @urbanflow/icons && node scripts/llms.mjs && shadcn build && next build",
    "check": "npm run build -w @urbanflow/icons && node scripts/llms.mjs && tsc --noEmit && tsc -p tsconfig.registry.json --noEmit && eslint . && shadcn build && npm run test:charts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build -w @urbanflow/icons && changeset publish",
    "test:charts": "node --import tsx --test tests/charts.test.ts"
  },
  "dependencies": {
    "@urbanflow/icons": "*",
    "@urbanflow/theme": "*",
    "chart.js": "4.4.7",
    "chartjs-chart-matrix": "3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "next": "^16.3.6",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
